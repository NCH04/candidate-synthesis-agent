# Required for live (non-demo) evaluations
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model routing — cheap model for simple extraction, smart model for reasoning.
# Defaults are sensible; override only if you want different tiers.
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6

# Economy mode: skip the critic + fairness passes (saves 2 of the priciest
# Claude calls per evaluation). true | false
ECONOMY_MODE=false

# Demo mode: serve pre-computed sample results with ZERO API calls.
# Set to true for a public deployment so anyone can try it without spending
# your API budget. No ANTHROPIC_API_KEY is needed when DEMO_MODE=true.
DEMO_MODE=false
