# ─────────────────────────────────────────────────────────────────────────────
# Required for live (non-demo) evaluations
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Model routing — cheap model for extraction, smart model for reasoning.
# Defaults are sensible; override only if you want different tiers.
# ─────────────────────────────────────────────────────────────────────────────
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-5

# ─────────────────────────────────────────────────────────────────────────────
# Cost controls
# ─────────────────────────────────────────────────────────────────────────────
# Economy mode: skip the critic pass (the priciest Claude call).
# The fairness review is never skipped — it is a compliance guardrail, and the
# local pre-filter already makes it free on a clean report. true | false
ECONOMY_MODE=false

# Demo mode: serve pre-computed sample results with ZERO API calls.
# Set to true for a public deployment so anyone can try it without spending
# your API budget. No ANTHROPIC_API_KEY is needed when DEMO_MODE=true.
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# Hardening — every one of these is a no-op until you set it, so local dev is
# unchanged. Set them before exposing a LIVE (non-demo) deployment: without
# APP_API_KEY the API is an unauthenticated proxy to your paid Claude account.
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret. When set, every /api call must send `X-API-Key: <value>`.
APP_API_KEY=

# Comma-separated CORS allow-list. `*` also disables credentialed CORS
# (wildcard + credentials is invalid per the CORS spec).
ALLOWED_ORIGINS=*

# Max accepted upload size, in megabytes.
MAX_UPLOAD_MB=10

# Per-IP requests per minute on the expensive routes. 0 disables the limit.
RATE_LIMIT_PER_MINUTE=20
